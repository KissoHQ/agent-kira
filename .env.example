# Configuration of the whole project. Copy this file to .env and set a password.

# --- Database: local PostgreSQL started with Docker Compose ---

# Password of the request_agent database user. Use any local value, never a real one.
POSTGRES_PASSWORD=change-me

# Host port of the database. 5433 avoids a conflict with another PostgreSQL on 5432.
POSTGRES_PORT=5433

# Connection to the development database. Use the same password and port as above.
DATABASE_URL=postgresql://request_agent:change-me@127.0.0.1:5433/request_agent

# Connection used by the application, with the restricted request_agent_app role. The migrations
# create the role and `pnpm db:migrate` sets its password from this URL. Use another password.
APP_DATABASE_URL=postgresql://request_agent_app:change-me-too@127.0.0.1:5433/request_agent

# Connection used by the server and the agent, with the request_agent_server role, which has fewer
# rights still: none on the accounts of the team, and it cannot change what a message said. Its
# password is set by `pnpm db:migrate`, printable ASCII characters only.
SERVER_DATABASE_URL=postgresql://request_agent_server:change-me-three@127.0.0.1:5433/request_agent

# Database used by the tests. Its name must end with _test: the tests empty it before each test.
TEST_DATABASE_URL=postgresql://request_agent:change-me@127.0.0.1:5433/request_agent_test

# --- Server (`pnpm dev`) and agent (`pnpm agent`) ---

# Ollama API endpoint (default local install). Must end with /api.
OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# Ollama model used by the classifier and the agent. It must be pulled first: ollama pull ornith:9b
OLLAMA_MODEL=ornith:9b

# Bearer token of an authenticating proxy in front of a remote Ollama. Optional: an Ollama on this
# machine needs none.
# OLLAMA_API_KEY=

# Password the server gives to call the agent, which runs in its own process. Only the two of them
# know it: at least 32 characters. Generate it with: openssl rand -hex 32
AGENT_PASSWORD=change-me-to-a-random-value-of-32-characters

# Address of the agent, as the server reaches it. Optional: http://127.0.0.1:4120 by default, where
# `pnpm agent` listens; compose.production sets http://agent:4120.
# AGENT_URL=http://127.0.0.1:4120

# Level of the logs of the server: debug, info, warn or error. Optional, info by default.
# LOG_LEVEL=info

# Address and port of /health and /ready of the server. Optional: 127.0.0.1 and 4111 by default,
# which keeps them to this machine, or to its own container with compose.production. The widget has
# its own port, WIDGET_PORT.
# SERVER_HOST=127.0.0.1
# SERVER_PORT=4111

# Model of the knowledge base, which turns help articles and questions into vectors of 1024
# numbers, for the agent and `pnpm kb:import`. Optional: by default qwen3-embedding:0.6b, chosen in
# docs/decisions/010. It must be pulled first: ollama pull qwen3-embedding:0.6b
# OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Below this confidence, from 0 to 1, a classified request waits for a human review. Optional:
# the default, 0.8, comes from the measurements described in docs/agent.md.
# CLASSIFICATION_REVIEW_THRESHOLD=0.8

# Longest waits for the model, in whole seconds. Their right values depend on the machine that runs
# Ollama: measure them there with `pnpm eval:agent`, as docs/agent.md describes. Optional: the
# defaults were measured on the CPU of a development machine.
# One call that classifies a message or judges a duplicate.
# CLASSIFICATION_TIMEOUT_SECONDS=300
# The whole run of the agent on one message, its rewrite included. A run cut by it is answered by
# code and filed for a person.
# AGENT_TIMEOUT_SECONDS=2000
# One call of the agent that turns a question into a vector, to search the help articles.
# EMBEDDING_TIMEOUT_SECONDS=60

# --- Web interface of the team, started with `pnpm web` ---
# It uses APP_DATABASE_URL. Accounts are created with `pnpm staff:add`.

# Address and port it listens on. Optional: by default only this machine, on port 4112. Expose it
# to the network only behind HTTPS: the session cookie is kept over HTTPS, or on localhost by Chrome
# and Firefox (not Safari).
# WEB_HOST=127.0.0.1
# WEB_PORT=4112

# Time zone of the dates shown, as an IANA name. Optional, Europe/Paris by default.
# WEB_TIME_ZONE=Europe/Paris

# Set to true only behind a reverse proxy that adds the address of the person to X-Forwarded-For.
# The limit of sign-in attempts per network address then counts people, not the proxy. Optional,
# false by default: a client could otherwise send any address in this header.
# WEB_TRUST_PROXY=false

# Origin of the interface as people reach it behind a reverse proxy, such as
# https://kira.example.com. Optional: forms are then only accepted from it.
# WEB_PUBLIC_ORIGIN=

# --- Web widget, optional: without allowed origins, the server runs without it ---
# See docs/widget.md.

# Origins of the applications that embed the widget, separated by commas. The demo page of
# `pnpm demo:widget` runs on http://localhost:4114.
# WIDGET_ALLOWED_ORIGINS=http://localhost:4114

# One secret per project, given only to the application of that project, which signs the identity
# of the person signed in: PROJECT=secret, separated by commas. Optional: a project without a
# secret has only unverified people. Generate each one with: openssl rand -hex 32
# WIDGET_IDENTITY_SECRETS=PORTAL=

# Absolute path of the folder where the files attached through the widget are written. The web
# interface uses the same folder: the team downloads the files, and an administrator deletes them.
# ATTACHMENTS_DIR=/home/you/request-agent-attachments

# Days the daily purge keeps the files attached through the widget. Optional, 40 by default. The
# web interface tells the team the same number.
# ATTACHMENT_RETENTION_DAYS=40

# Most space the attached files may take, in megabytes. Optional, 2048 by default: beyond, files
# are refused and messages without files are still taken.
# WIDGET_ATTACHMENTS_QUOTA_MB=2048

# Set to true only behind a reverse proxy that adds the address of the person to X-Forwarded-For,
# so the limits of the widget count people and not the proxy. Optional, false by default.
# WIDGET_TRUST_PROXY=false

# Address and port the widget listens on, apart from /health and /ready, so it sees the address of
# each person. Optional: 127.0.0.1 and 4113 by default; compose.production sets 0.0.0.0.
# WIDGET_HOST=127.0.0.1
# WIDGET_PORT=4113

# --- Slack, optional: without these two tokens, the server runs without Slack ---

# Bot token of the Slack app (OAuth & Permissions > Bot User OAuth Token). Starts with xoxb-.
# SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token with the connections:write scope (Basic Information > App-Level Tokens), used to
# open the Socket Mode connection. Starts with xapp-.
# SLACK_APP_TOKEN=xapp-your-app-token

# --- Local mail server started by `pnpm db:up`, on this machine only ---

# Login and password of the agent's mailbox on the local server. Use any local value, never a real
# one: they stay local when the agent uses Gmail.
LOCAL_MAIL_USER=agent
LOCAL_MAIL_PASSWORD=change-me-mail

# Ports of the local server on this machine. Optional: 3143 and 3025 by default. They stay the same
# when the agent uses Gmail.
# LOCAL_MAIL_IMAP_PORT=3143
# LOCAL_MAIL_SMTP_PORT=3025

# --- Email: the agent's mailbox ---
# The values below fit the local mail server above: the same login, password and ports. For Gmail,
# see "With Gmail" in the README: an account for the agent alone, imap.gmail.com 993,
# smtp.gmail.com 465, EMAIL_SECURE=true and an app password.

# Login and password of the mailbox. On Gmail, the login is the address and the password is an app
# password, never the account password.
EMAIL_USER=agent
EMAIL_PASSWORD=change-me-mail
# Address the agent receives and answers from.
EMAIL_ADDRESS=agent@requests.example
EMAIL_IMAP_HOST=127.0.0.1
EMAIL_IMAP_PORT=3143
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=3025
# true to connect with TLS from the start, as real mail servers require, on their TLS ports such as
# 993 and 465. false is only accepted for mail servers on this machine, such as the local one.
EMAIL_SECURE=false

# Server name written by the receiving mail server in its Authentication-Results header, such as
# mx.google.com. Only that header is trusted to tell that a sender passed DMARC. Optional: without
# it, every email sender is unverified.
# EMAIL_TRUSTED_AUTHSERV_ID=mx.google.com

# Local tests only: treat every email sender as verified. Refused unless the mailbox is on this
# machine, since the local server checks no sender.
# EMAIL_TRUST_LOCAL_SENDERS=true

# Mailbox of the tests, on the local server, even when the agent uses Gmail. The tests empty it.
TEST_EMAIL_USER=agent-test
TEST_EMAIL_PASSWORD=change-me-mail-test
# Server of the tests' mailbox. Optional: by default the local mail server, on its ports above.
# TEST_EMAIL_HOST=127.0.0.1
# TEST_EMAIL_IMAP_PORT=3143
# TEST_EMAIL_SMTP_PORT=3025
