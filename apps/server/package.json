{
  "name": "@request-agent/server",
  "version": "0.1.0",
  "private": true,
  "description": "Server of KIRA: channel adapters, classification, answer check and delivery",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "demo:email": "node --env-file-if-exists=../../.env scripts/demo-email.ts",
    "demo:widget": "node --env-file-if-exists=../../.env scripts/demo-widget.ts",
    "eval:agent": "vitest run --config vitest.eval.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@request-agent/core": "workspace:*",
    "@slack/socket-mode": "catalog:",
    "@slack/web-api": "catalog:",
    "email-reply-parser": "catalog:",
    "hono": "catalog:",
    "imapflow": "catalog:",
    "nodemailer": "catalog:",
    "postal-mime": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@request-agent/agent": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
